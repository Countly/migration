{
  "name": "mongo-to-clickhouse-migrator",
  "version": "1.0.0",
  "description": "MongoDB to ClickHouse migration service for countly_drill.drill_events",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "node --experimental-strip-types --expose-gc --max-old-space-size=2048 src/main.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:file": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@clickhouse/client": "^1.8.0",
    "fastify": "^5.2.1",
    "mongodb": "^6.12.0",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=25.8.0"
  }
}
